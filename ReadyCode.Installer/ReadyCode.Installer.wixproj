<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>
  <PropertyGroup>
    <!-- From Directory.Build.props (MSI upgrades compare only the first three parts) -->
    <InstallerVersion>$(ReadyCodeVersion).0</InstallerVersion>
  </PropertyGroup>
  <PropertyGroup>
    <AcceptEula>true</AcceptEula>
    <!-- x64 by default; build with -p:Platform=ARM64 for the native ARM64 installer -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'x86'">x64</Platform>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <PropertyGroup>
    <AppRuntimeIdentifier>win-$(Platform.ToLowerInvariant())</AppRuntimeIdentifier>
    <DefineConstants>InstallerVersion=$(InstallerVersion);AppRuntimeIdentifier=$(AppRuntimeIdentifier)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <OutputName>READYCode</OutputName>
    <OutputName Condition="'$(Platform)' == 'ARM64'">READYCode-arm64</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Package.en-us.wxl" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Installer-Background.bmp" />
    <Content Include="Installer-Banner.bmp" />
    <Content Include="License.rtf" />
  </ItemGroup>
</Project>