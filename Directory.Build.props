<Project>

  <!-- READYCode's version - the single place to change it. Imported automatically by every
       project under this folder, and from here it becomes:
         - the app's assembly/file version (ReadyCode.csproj <Version>), shown in About and
           written to error.log
         - the MSI's ProductVersion (ReadyCode.Installer.wixproj)
         - the MSIX package Identity version, as $(ReadyCodeVersion).0 (ReadyCode.Packaging.wapproj
           stamps it into a copy of Package.appxmanifest at build time)
       Major.Minor.Build only: the Microsoft Store reserves the fourth (revision) part and
       requires it to be 0, so bump the Build part for each Store submission. The release
       workflow also checks that a pushed vX.Y.Z tag matches this value. -->
  <PropertyGroup>
    <ReadyCodeVersion>2.5.0</ReadyCodeVersion>
  </PropertyGroup>

  <!-- Code style: reports the .editorconfig rules set to "warning" (e.g. IDE0005, unused usings)
       during builds, not only in the editor. The compiler only reports unused usings when it
       parses doc comments, so documentation generation is on - but the XML file it produces
       isn't wanted, so it stays in obj\ (not copied to bin\ or published), and missing-doc-comment
       warnings (CS1591) are off. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
