<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!-- Self-contained, ReadyToRun ARM64 publish to the default publish folder
     (bin\Release\net10.0-windows\win-arm64\publish\) - the folder the WiX installer packages
     when built with -p:Platform=ARM64. See FolderProfile.pubxml for the x64 equivalent. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
