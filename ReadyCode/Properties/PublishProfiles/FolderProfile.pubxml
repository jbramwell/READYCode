<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!-- Self-contained, ReadyToRun x64 publish to the default publish folder
     (bin\Release\net10.0-windows\win-x64\publish\) - the folder the WiX installer packages.
     See FolderProfile-ARM64.pubxml for the ARM64 equivalent. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
