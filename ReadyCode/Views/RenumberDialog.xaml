<Window x:Class="ReadyCode.Views.RenumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="ThreeDBorderWindow"
        Title="Renumber Code"
        AllowsTransparency="False"
        Background="Transparent"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ThemedRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSettingsLabelFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" Margin="0,0,6,0">
                                <Ellipse x:Name="outer"
                                         Stroke="{DynamicResource ThemeSettingsInputBorder}"
                                         StrokeThickness="1.5"
                                         Fill="{DynamicResource ThemeSettingsInputBg}"/>
                                <Ellipse x:Name="inner"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource ThemeSettingsAccent}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource ThemeSettingsAccent}"/>
                                <Setter TargetName="inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource ThemeSettingsAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeSettingsDescFg}"/>
                                <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource ThemeSettingsDescFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeSettingsContentBg}"
            BorderBrush="{DynamicResource ThemeSettingsDivider}"
            BorderThickness="1"
            CornerRadius="4">
        <DockPanel>

            <!-- Content -->
            <StackPanel Margin="16,14,16,16">

                <TextBlock Text="Starting line number:"
                           FontSize="12"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource ThemeSettingsLabelFg}"/>
                <TextBox x:Name="StartLineNumberBox"
                         FontSize="14"
                         Margin="0,0,0,16"
                         Padding="4,5,4,4"
                         BorderThickness="0,0,0,2"
                         BorderBrush="{DynamicResource ThemeSettingsAccent}"
                         Background="{DynamicResource ThemeSettingsInputBg}"
                         Foreground="{DynamicResource ThemeSettingsLabelFg}"
                         CaretBrush="{DynamicResource ThemeSettingsAccent}"
                         KeyDown="TextBox_KeyDown"/>

                <TextBlock Text="Increment:"
                           FontSize="12"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource ThemeSettingsLabelFg}"/>
                <TextBox x:Name="IncrementBox"
                         FontSize="14"
                         Margin="0,0,0,16"
                         Padding="4,5,4,4"
                         BorderThickness="0,0,0,2"
                         BorderBrush="{DynamicResource ThemeSettingsAccent}"
                         Background="{DynamicResource ThemeSettingsInputBg}"
                         Foreground="{DynamicResource ThemeSettingsLabelFg}"
                         CaretBrush="{DynamicResource ThemeSettingsAccent}"
                         KeyDown="TextBox_KeyDown"/>

                <TextBlock Text="Renumber:"
                           FontSize="12"
                           Margin="0,0,0,8"
                           Foreground="{DynamicResource ThemeSettingsLabelFg}"/>
                <RadioButton x:Name="RadioAllLines"
                             Style="{StaticResource ThemedRadioButton}"
                             Content="All lines"
                             GroupName="RenumberScope"
                             IsChecked="True"
                             Margin="0,0,0,8"/>
                <RadioButton x:Name="RadioSelectedOnly"
                             Style="{StaticResource ThemedRadioButton}"
                             Content="Selected lines only"
                             GroupName="RenumberScope"
                             Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource DialogButtonStyle}"
                            Content="Renumber" Width="90"
                            Margin="0,0,10,0" IsDefault="True"
                            Click="Ok_Click"/>
                    <Button Style="{StaticResource DialogButtonStyle}"
                            Content="Cancel" Width="90"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>

            </StackPanel>
        </DockPanel>
    </Border>

</Window>
