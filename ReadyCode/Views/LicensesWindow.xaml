<Window x:Class="ReadyCode.Views.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="NoResize"
        Title="Third-Party Licenses"
        Background="{DynamicResource ThemeSettingsContentBg}"
        Width="560" Height="520"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Third-Party Licenses"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeSettingsLabelFg}"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeSettingsInputBg}"
                BorderBrush="{DynamicResource ThemeSettingsInputBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <TextBlock x:Name="LicenseText"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeSettingsDescFg}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Style="{StaticResource DialogButtonStyle}"
                Content="OK" Width="90"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                IsDefault="True"
                Click="CloseButton_Click"/>
    </Grid>

</Window>
