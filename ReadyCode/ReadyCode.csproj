<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Debug builds target the host machine's architecture (win-x64 or win-arm64) so the
         VS Code debugger, which only attaches to native-architecture processes, works on both.
         The RID is left out of the output path so launch.json doesn't depend on it. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath Condition="'$(Configuration)' != 'Release'">false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    
    <!-- Set once for the whole repo in Directory.Build.props; the SDK derives AssemblyVersion,
         FileVersion, and the product version from it. -->
    <Version>$(ReadyCodeVersion)</Version>

    <!-- Self-contained publish so users don't need .NET 10 installed.
         Release-only: Debug builds stay in the standard output path so launch.json works unchanged.
         Release targets the requested Platform (x64 or ARM64 - the packaging project builds one
         per bundle platform), defaulting to win-x64 when no specific platform is given. -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>

    <ApplicationIcon>READYCode.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nests MainWindow's partial-class files (MainWindow.Files.cs, MainWindow.Search.cs, ...)
         under MainWindow.xaml in Solution Explorer, alongside MainWindow.xaml.cs. -->
    <Compile Update="Views\MainWindow.*.cs" DependentUpon="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives access to System.Windows.Forms.ColorDialog without enabling
         UseWindowsForms, which would inject conflicting implicit usings. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Also embedded (Content alone doesn't go into the .g.resources bundle), so
         pack://application:,,,/ReadyCode;component/... URIs resolve in XAML -->
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="READYCode.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the editor and printing render PETSCII glyphs correctly even when the
         font isn't installed on the machine - see Assets\Fonts\LICENSE-PetMe64.txt for terms. -->
    <Resource Include="Assets\Fonts\PetMe64.ttf" />
    <Content Include="Assets\Fonts\LICENSE-PetMe64.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the SID note frequency table (Music Notes panel) is read from the
         assembly at runtime instead of relying on a loose file next to the executable. -->
    <EmbeddedResource Include="Assets\Data\sid_notes.csv" />
  </ItemGroup>

</Project>
